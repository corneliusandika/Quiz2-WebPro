<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
                            http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    <description>Dompetku formatting functions</description>
    <tlib-version>1.0</tlib-version>
    <short-name>f</short-name>
    <uri>http://dompetku.app/functions</uri>

    <function>
        <description>Format a number as Indonesian rupiah</description>
        <name>rupiah</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String rupiah(java.math.BigDecimal)</function-signature>
    </function>

    <function>
        <description>Compact rupiah for stat cards</description>
        <name>compact</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String compact(java.math.BigDecimal)</function-signature>
    </function>

    <function>
        <description>Indonesian short date</description>
        <name>date</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String date(java.time.LocalDate)</function-signature>
    </function>

    <function>
        <description>Indonesian full month</description>
        <name>month</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String month(java.time.LocalDate)</function-signature>
    </function>

    <function>
        <description>Indonesian short month</description>
        <name>shortMonth</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String shortMonth(java.time.LocalDate)</function-signature>
    </function>

    <function>
        <description>Initials for an avatar</description>
        <name>initials</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String initials(java.lang.String)</function-signature>
    </function>

    <function>
        <description>Thousands separator without currency</description>
        <name>thousands</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String thousands(java.math.BigDecimal)</function-signature>
    </function>

    <function>
        <description>HTML-escape text and attribute values</description>
        <name>esc</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String escapeHtml(java.lang.String)</function-signature>
    </function>

    <function>
        <description>Format a money input value with thousands separators</description>
        <name>moneyInput</name>
        <function-class>com.dompetku.util.Formats</function-class>
        <function-signature>java.lang.String moneyInput(java.math.BigDecimal)</function-signature>
    </function>
</taglib>
