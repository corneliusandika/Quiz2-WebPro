<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="f" uri="http://dompetku.app/functions" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="u" value="${sessionScope.user}"/>
<c:set var="pageTitle" value="${empty pageTitle ? 'Dompetku' : pageTitle}"/>
<!doctype html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="text-scale" content="scale">
    <meta name="currency-decimals" content="${currencyMode}">
    <title>${pageTitle} &middot; Dompetku</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap"
          rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="${ctx}/assets/img/favicon.svg">
    <link rel="stylesheet" href="${ctx}/assets/css/app.css?v=20261119-31">
    <script>
        (function () {
            var root = document.documentElement;
            var mode = 'system';
            try {
                var stored = localStorage.getItem('dompetku-theme');
                if (stored === 'light' || stored === 'dark') { mode = stored; }
            } catch (e) { /* ignore */ }
            var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            root.setAttribute('data-theme', mode === 'system' ? (systemDark ? 'dark' : 'light') : mode);
            root.setAttribute('data-theme-mode', mode);
            var meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) { meta.content = mode === 'system' ? 'light dark' : mode; }
            try {
                if (localStorage.getItem('dompetku-sidebar-expanded') === 'true' &&
                    window.matchMedia && window.matchMedia('(min-width: 1181px)').matches) {
                    root.classList.add('sidebar-expanded');
                }
            } catch (e) { /* ignore */ }
        })();
    </script>
</head>
<body class="app-body">
<a class="skip-link" href="#mainContent">Lewati ke konten</a>
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <button type="button" class="icon-btn sidebar-close" id="sidebarClose" aria-label="Tutup menu">
            <ui:icon name="x"/>
        </button>
        <a class="brand" href="${ctx}/app/dashboard">
            <span class="brand-mark">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 8.5A3.5 3.5 0 0 1 6.5 5H18a2 2 0 0 1 2 2v1.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    <rect x="3" y="7.5" width="18" height="12.5" rx="3.2" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M15.5 14.2h2.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    <path d="M7 7.5V6.2A2.2 2.2 0 0 1 9.2 4l6.6 1.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </span>
            <span class="brand-text">
                <strong>Dompetku</strong>
                <small>finance workspace</small>
            </span>
        </a>

        <nav class="nav">
            <p class="nav-label">Workspace</p>
            <a class="nav-item ${active eq 'dashboard' ? 'is-active' : ''}" href="${ctx}/app/dashboard">
                <ui:icon name="home"/><span>Dashboard</span>
            </a>
            <a class="nav-item ${active eq 'transactions' ? 'is-active' : ''}" href="${ctx}/app/transactions">
                <ui:icon name="transactions"/><span>Transaksi</span>
            </a>
            <a class="nav-item ${active eq 'wallets' ? 'is-active' : ''}" href="${ctx}/app/wallets">
                <ui:icon name="wallet"/><span>Dompet</span>
            </a>

            <p class="nav-label">Perencanaan</p>
            <a class="nav-item ${active eq 'budgets' ? 'is-active' : ''}" href="${ctx}/app/budgets">
                <ui:icon name="budget"/><span>Budget</span>
            </a>
            <a class="nav-item ${active eq 'goals' ? 'is-active' : ''}" href="${ctx}/app/goals">
                <ui:icon name="goals"/><span>Target Tabungan</span>
            </a>
            <a class="nav-item ${active eq 'debts' ? 'is-active' : ''}" href="${ctx}/app/debts">
                <ui:icon name="debts"/><span>Utang &amp; Piutang</span>
            </a>
            <a class="nav-item ${active eq 'recurring' ? 'is-active' : ''}" href="${ctx}/app/recurring">
                <ui:icon name="recurring"/><span>Transaksi Berulang</span>
            </a>
            <a class="nav-item ${active eq 'categories' ? 'is-active' : ''}" href="${ctx}/app/categories">
                <ui:icon name="categories"/><span>Kategori</span>
            </a>
            <a class="nav-item ${active eq 'reports' ? 'is-active' : ''}" href="${ctx}/app/reports">
                <ui:icon name="reports"/><span>Laporan</span>
            </a>

            <p class="nav-label">Akun</p>
            <a class="nav-item ${active eq 'profile' ? 'is-active' : ''}" href="${ctx}/app/profile">
                <ui:icon name="user"/><span>Profil Saya</span>
            </a>
        </nav>

        <div class="sidebar-foot">
            <a class="sidebar-user" href="${ctx}/app/profile">
                <span class="avatar">${f:initials(u.name)}</span>
                <span class="sidebar-user-text">
                    <strong>${f:esc(u.name)}</strong>
                    <small>Personal account</small>
                </span>
            </a>
            <form method="post" action="${ctx}/logout" class="logout-form">
                <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
                <button type="submit" class="icon-btn subtle" title="Keluar" aria-label="Keluar">
                    <ui:icon name="logout"/>
                </button>
            </form>
        </div>
    </aside>

    <button type="button" class="sidebar-pin" id="sidebarPin"
            aria-label="Buka menu" aria-expanded="false" aria-controls="sidebar"
            data-sidebar-tooltip="Buka menu">
        <span class="sidebar-pin-icon sidebar-pin-open"><ui:icon name="chevron-right"/></span>
        <span class="sidebar-pin-icon sidebar-pin-close"><ui:icon name="chevron-left"/></span>
    </button>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="main">
        <header class="topbar">
            <button class="icon-btn menu-btn" id="menuToggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="sidebar">
                <ui:icon name="menu"/>
            </button>
            <div class="page-heading">
                <p class="eyebrow">${empty eyebrow ? 'Dompetku workspace' : eyebrow}</p>
                <h1>${pageTitle}</h1>
            </div>
            <div class="topbar-actions">
                <search class="global-search-wrap" aria-label="Pencarian transaksi">
                    <form class="global-search" method="get" action="${ctx}/app/transactions">
                        <ui:icon name="search"/>
                        <label class="sr-only" for="globalSearch">Cari transaksi</label>
                        <input type="search" id="globalSearch" name="q" placeholder="Cari transaksi..." value="${f:esc(filterQ)}">
                    </form>
                </search>
                <a class="btn btn-primary topbar-cta" href="${ctx}/app/transactions/new">
                    <ui:icon name="plus"/><span>Transaksi</span>
                </a>
                <button class="icon-btn theme-toggle" id="themeToggle" type="button" aria-label="Ubah tema">
                    <span class="theme-icon-system"><ui:icon name="auto"/></span>
                    <span class="theme-icon-light"><ui:icon name="sun"/></span>
                    <span class="theme-icon-dark"><ui:icon name="moon"/></span>
                </button>
                <div class="user-menu-wrap">
                    <button class="user-chip" type="button" id="userMenuToggle" aria-haspopup="menu" aria-expanded="false" aria-controls="userMenu">
                        <span class="avatar">${f:initials(u.name)}</span>
                        <span class="user-chip-text"><strong>${f:esc(u.name)}</strong><small>Personal</small></span>
                        <ui:icon name="chevron-down"/>
                    </button>
                    <div class="user-menu" id="userMenu" role="menu" aria-labelledby="userMenuToggle" hidden>
                        <a href="${ctx}/app/profile" role="menuitem">
                            <ui:icon name="user"/><span>Profil Saya</span>
                        </a>
                        <div class="user-menu-divider"></div>
                        <form method="post" action="${ctx}/logout">
                            <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
                            <button type="submit" role="menuitem" class="user-menu-logout">
                                <ui:icon name="logout"/><span>Keluar</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <main class="content" id="mainContent" tabindex="-1">
            <%@ include file="/WEB-INF/views/layout/flash.jspf" %>
