# Copy this file to .env before running docker compose.
# Use a long random password, not the example value.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password

DOMPETKU_ENV=development
# Untuk production publik: ubah ke production SETELAH semua nilai keamanan di bawah terisi.
DOMPETKU_PUBLIC_URL=http://localhost:8080/dompetku
DOMPETKU_DB_SSL_MODE=DISABLED
DOMPETKU_DB_CREATE_DATABASE=true
DOMPETKU_DB_USER=root
DOMPETKU_DB_PASSWORD=replace-with-a-long-random-password
DOMPETKU_AUDIT_RETENTION_DAYS=365

# SMTP is required for forgot-password and email verification.
DOMPETKU_SMTP_HOST=smtp.example.com
DOMPETKU_SMTP_PORT=587
DOMPETKU_SMTP_USER=no-reply@example.com
DOMPETKU_SMTP_PASSWORD=replace-with-smtp-password
DOMPETKU_SMTP_FROM=no-reply@example.com
DOMPETKU_SMTP_STARTTLS=true
DOMPETKU_SMTP_SSL=false

# Set true only when the app is served over HTTPS.
DOMPETKU_SECURE_COOKIES=false
DOMPETKU_REQUIRE_EMAIL_VERIFICATION=false
